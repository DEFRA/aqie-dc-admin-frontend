{% extends "layouts/page.njk" %}

{% block pageTitle %}
  {{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if error %}
      {{ govukErrorSummary({
        titleText: content.errors.summaryTitle,
        errorList: [
          {
            text: error.message,
            href: error.href
          }
        ]
      }) }}
    {% endif %}

    <h1 class="govuk-heading-xl">{{ heading }}</h1>

    {% set permittedFuelsError = null %}
    {% if error and error.field == 'permFuelsCS' %}
      {% set permittedFuelsError = { text: error.message } %}
    {% endif %}

    {% set woodCSError = null %}
    {% if error and error.field == 'woodCS' %}
      {% set woodCSError = { text: error.message } %}
    {% endif %}

    <form method="post"
          action="/review-appliance/{{ appliance.id }}/permitted-fuels"
          novalidate>
      {{ govukTextarea({
        id: "perm-fuels",
        name: "permFuelsCS",
        rows: 5,
        value: formValues.permFuelsCS,
        formGroup: {
          classes: "govuk-!-margin-bottom-9"
        },
        label: {
          text: content.permittedFuelsLabel,
          classes: "govuk-label--l"
        },
        errorMessage: permittedFuelsError
      }) }}

      {{ govukRadios({
        idPrefix: "woodCS",
        name: "woodCS",
        classes: "govuk-radios--inline",
        fieldset: {
          legend: {
            text: content.woodQuestion,
            classes: "govuk-fieldset__legend--l"
          }
        },
        hint: {
          text: content.woodHint
        },
        errorMessage: woodCSError,
        items: [
          {
            value: content.yes,
            text: content.yes,
            checked: formValues.woodCS == content.yes
          },
          {
            value: content.no,
            text: content.no,
            checked: formValues.woodCS == content.no
          }
        ]
      }) }}

      <div class="govuk-button-group govuk-!-margin-top-7">
        {{ govukButton({
          text: content.markAsCompleted
        }) }}
      </div>

      <p><a class="govuk-link" href="{{ reviewHref }}">{{ content.cancel }}</a></p>
    </form>

  </div>
</div>

{% endblock %}
