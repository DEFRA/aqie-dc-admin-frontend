{% extends "layouts/page.njk" %}

{% block pageTitle %}
  {{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if error %}
      {{ govukErrorSummary({
        titleText: content.errors.summaryTitle,
        errorList: [{ text: error.message, href: error.href }]
      }) }}
    {% endif %}

    <form method="post" action="{{ sulphurContentAction }}" novalidate>
      {{ govukInput({
        name: "sulphurContent",
        id: "sulphurContent",
        value: formValue,
        classes: "govuk-input--width-5",
        inputmode: "decimal",
        spellcheck: false,
        suffix: { text: content.suffix },
        label: {
          text: content.label,
          classes: "govuk-label--l",
          isPageHeading: true
        },
        errorMessage: { text: error.message } if error else undefined
      }) }}

      {{ govukButton({ text: content.saveButton }) }}
    </form>

    <p>
      <a class="govuk-link" href="{{ fuelDetailsHref }}">{{ content.cancel }}</a>
    </p>

  </div>
</div>

{% endblock %}