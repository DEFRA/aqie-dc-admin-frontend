{#
  Unified brand-name form for both:
  - Manufacturer: "What is the brand name?"
  - Rebrand: "What is the rebranded name?"

  Uses content.fieldName and content.fieldId to determine form field structure.
#}
{% extends "layouts/page.njk" %}

{% block pageTitle %}
  {{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if error %}
      {{ govukErrorSummary({
        titleText: content.errorSummaryTitle,
        errorList: [
          {
            text: error.message,
            href: error.href
          }
        ]
      }) }}
    {% endif %}

    {% set brandNameError = null %}
    {% set inputClasses = '' %}
    {% if error and error.field == content.fieldName %}
      {% set brandNameError = { text: error.message } %}
      {% set inputClasses = 'govuk-input--error' %}
    {% endif %}

    <form method="post"
          action="{{ brandNameAction }}"
          novalidate>
      {{ govukInput({
        id: content.fieldId,
        name: content.fieldName,
        value: formValue,
        label: {
          text: content.label,
          classes: "govuk-label--xl",
          isPageHeading: true
        },
        errorMessage: brandNameError,
        classes: inputClasses
      }) }}

      <div class="govuk-button-group govuk-!-margin-top-7">
        {{ govukButton({
          text: content.saveButton
        }) }}

        <a class="govuk-link" href="{{ fuelDetailsHref }}">{{ content.cancel }}</a>
      </div>
    </form>

  </div>
</div>

{% endblock %}
