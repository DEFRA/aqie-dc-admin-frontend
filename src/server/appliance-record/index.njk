{% extends "layouts/page.njk" %}

{% block pageTitle %}
{{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        {# 
        APPLIANCE RECORD PAGE
        
        This template renders a complete appliance record with:
        1. Back link for browser navigation
        2. Page heading with dynamic status tag as caption (yellow/green/grey per GOV.UK)
        3. Public listing section with visibility link (if applicable)
        4. Certification status table (all 4 countries with status and change links)
        5. Details section with links to related pages
        6. Visibility toggle buttons (hide/make public) if applicable
        7. Return link to appliance-records list
        
        All content/labels come from controller context (content.js).
        All URLs are pre-generated by data transformation layer.
        Template focuses purely on rendering with minimal logic.
        #}

        <!-- Back link for browser navigation -->
        <a href="javascript:window.history.back()" class="govuk-back-link">Back</a>

        <!-- Page heading with dynamic status tag as caption -->
        <!-- Status label shown as GOV.UK caption within the heading -->
        <h1 class="govuk-heading-xl">
            <span class="govuk-caption-xl">
                <strong class="govuk-tag {{ statusDisplay.tagClass }}"
                    style="display: inline-block !important; white-space: nowrap !important; padding: 3px 6px !important; line-height: 1.4 !important; width: auto !important; max-width: none !important;">
                    {{ statusDisplay.label }}
                </strong>
            </span>
            {{ appliance.modelName }}
        </h1>

        <!-- Public listing section: shows link to view public listing -->
        <!-- Only shown for live appliances -->
        {% if publicListing.showLink %}
        <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">{{ publicListingTitle }}</h2>
            </div>
            <div class="govuk-summary-card__content">
                <p><a href="{{ publicListing.url }}" target="_blank">{{ publicListing.linkText }}</a></p>
            </div>
        </div>
        {% endif %}

        <!-- Certification status section: displays 4-country certification table -->
        <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">{{ certificationStatusTitle }}</h2>
            </div>
            <div class="govuk-summary-card__content">
                {{ govukTable({
                    head: [
                        { text: tableHeaders.country },
                        { text: tableHeaders.status },
                        { text: tableHeaders.dateCertified },
                        { text: tableHeaders.action }
                    ],
                    rows: certificationTableRows
                }) }}
            </div>
        </div>

        <!-- Details section: links to related appliance information pages -->
        <!-- Uses GOV.UK summary list pattern with View links for each detail type -->
        {{ govukSummaryList({
            card: {
                title: {
                    text: detailsTitle
                }
            },
            rows: detailsRows
        }) }}

        <!-- Visibility toggle buttons: hide/make public appliance from public list -->
        <!-- Only shown for live or hidden appliances with appropriate permissions -->
        {% if actions.buttons.length > 0 %}
        <div class="govuk-button-group govuk-!-margin-top-7">
            {% for button in actions.buttons %}
            <a href="{{ button.href }}" role="button" draggable="false" class="{{ button.classes }}"
                data-module="govuk-button" data-govuk-button-init="">
                {{ button.text }}
            </a>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Return link to appliance-records list page -->
        <p><a href="{{ returnLinkUrl }}" class="govuk-link">{{ returnLinkText }}</a></p>
    </div>
</div>
{% endblock %}