{% extends "layouts/page.njk" %}

{% block content %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <p class="govuk-body govuk-!-margin-bottom-2">
            <strong class="govuk-tag app-tag--nowrap {{ statusDisplay.tagClass }}">{{ statusDisplay.label }}</strong>
        </p>
        <h1 class="govuk-heading-xl">{{ fuel.name }}</h1>

        {% if publicListing.showLink %}
        <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">{{ publicListingTitle }}</h2>
            </div>
            <div class="govuk-summary-card__content">
                <p class="govuk-body">
                    <a href="{{ publicListing.url }}" class="govuk-link" target="_blank" rel="noopener noreferrer">{{ publicListing.linkText }}<span class="govuk-visually-hidden"> (opens in new tab)</span></a>
                </p>
            </div>
        </div>
        {% endif %}

        <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title">{{ certificationStatusTitle }}</h2>
            </div>
            <div class="govuk-summary-card__content">
                {{ govukTable({
                    head: [
                        { text: tableHeaders.country },
                        { text: tableHeaders.status },
                        { text: tableHeaders.dateFirstCertified },
                        { text: tableHeaders.action }
                    ],
                    rows: certificationTableRows
                }) }}
            </div>
        </div>

        {{ govukSummaryList({
            card: { title: { text: detailsTitle } },
            rows: detailsRows
        }) }}

        {% if actions.buttons.length > 0 %}
        <div class="govuk-button-group govuk-!-margin-top-7">
            {% for button in actions.buttons %}
            <a href="{{ button.href }}" role="button" draggable="false" class="{{ button.classes }}" data-module="govuk-button">
                {{ button.text }}
            </a>
            {% endfor %}
        </div>
        {% endif %}

        <p class="govuk-body"><a href="{{ returnLinkUrl }}" class="govuk-link">{{ returnLinkText }}</a></p>
    </div>
</div>
{% endblock %}
