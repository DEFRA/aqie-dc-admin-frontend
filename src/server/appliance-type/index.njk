{% extends "layouts/page.njk" %}

{% block pageTitle %}
  {{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if error %}
      {{ govukErrorSummary({
        titleText: content.errors.summaryTitle,
        errorList: [
          {
            text: error.message,
            href: error.href
          }
        ]
      }) }}
    {% endif %}

    <form method="post"
          action="/review-appliance/{{ appliance.id }}/appliance-type"
          novalidate>

      {% set applianceTypeError = null %}
      {% if error and error.field == 'applianceType' %}
        {% set applianceTypeError = { text: error.message } %}
      {% endif %}

      <div class="govuk-form-group">
        <fieldset class="govuk-fieldset">
          <legend class="govuk-fieldset__legend govuk-fieldset__legend--xl">
            <h1 class="govuk-fieldset__heading">
              {{ heading }}
            </h1>
          </legend>

          {{ govukRadios({
            idPrefix: "applianceType",
            name: "applianceType",
            fieldset: {
              legend: {
                text: content.legend,
                isPageHeading: false,
                classes: "govuk-fieldset__legend--m"
              }
            },
            items: applianceTypeItems,
            errorMessage: applianceTypeError
          }) }}
        </fieldset>
      </div>

      <div class="govuk-button-group govuk-!-margin-top-7">
        {{ govukButton({
          text: content.saveButton
        }) }}
        <a class="govuk-link" href="{{ applianceDetailsHref }}">{{ content.cancel }}</a>
      </div>
    </form>

  </div>
</div>

{% endblock %}
