{% extends "layouts/page.njk" %}

{% block pageTitle %}
  {{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if error %}
      {{ govukErrorSummary({
        titleText: content.errors.summaryTitle,
        errorList: [
          {
            text: error.message,
            href: error.href
          }
        ]
      }) }}
    {% endif %}

    <form method="post" action="{{ action }}" novalidate>
      {% set additionalBrandsError = null %}
      {% if error and error.field == content.fieldName %}
        {% set additionalBrandsError = { text: error.message } %}
      {% endif %}

      <div class="govuk-form-group">
        {{ govukRadios({
          idPrefix: "addBrands",
          name: "addBrands",
          fieldset: {
            legend: {
              text: content.heading,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--xl"
            }
          },
          items: [
            {
              value: "Yes",
              text: content.yes,
              checked: hasAdditionalBrandNames,
              conditional: {
                html: govukCharacterCount({
                  id: content.fieldId,
                  name: content.fieldName,
                  label: {
                    text: content.brandsLabel,
                    classes: "govuk-label--m"
                  },
                  hint: {
                    text: content.brandsHint
                  },
                  rows: "5",
                  value: additionalBrandNamesValue,
                  errorMessage: additionalBrandsError,
                  classes: "govuk-textarea"
                })
              }
            },
            {
              value: "No",
              text: content.no,
              checked: not hasAdditionalBrandNames
            }
          ]
        }) }}
      </div>

      <div class="govuk-button-group govuk-!-margin-top-7">
        {{ govukButton({
          text: content.saveButton
        }) }}
      </div>

      <p><a class="govuk-link" href="{{ fuelDetailsHref }}">{{ content.cancel }}</a></p>
    </form>
  </div>
</div>
{% endblock %}
