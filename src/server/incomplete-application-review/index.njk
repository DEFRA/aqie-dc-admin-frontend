{% extends "layouts/page.njk" %}

{% block pageTitle %}
  {{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">{{ heading }}</h1>

    <p class="govuk-body">
      {{ introText }}
    </p>
    <p>
      <a href="{{ returnLink }}">{{ returnLinkText }}</a>
    </p>
  </div>
</div>

{% endblock %}
