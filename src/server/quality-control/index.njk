{% extends "layouts/page.njk" %}

{% block pageTitle %}
  {{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if error %}
      {{ govukErrorSummary({
        titleText: content.errors.summaryTitle,
        errorList: [{ text: error.message, href: error.href }]
      }) }}
    {% endif %}

    <form method="post" action="{{ qualityControlAction }}" novalidate>
      {{ govukRadios({
        name: "qualityControl",
        idPrefix: "qualityControl",
        fieldset: {
          legend: {
            text: content.heading,
            isPageHeading: true,
            classes: "govuk-fieldset__legend--l"
          }
        },
        errorMessage: { text: error.message } if error else undefined,
        items: [
          { value: "yes", text: content.yes, checked: formValue == "yes" },
          { value: "no", text: content.no, checked: formValue == "no" }
        ]
      }) }}

      {{ govukButton({ text: content.saveButton }) }}
    </form>

    <p>
      <a class="govuk-link" href="{{ fuelDetailsHref }}">{{ content.cancel }}</a>
    </p>

  </div>
</div>

{% endblock %}